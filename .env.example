# Scholight Environment Variables
# Copy this to .env and fill in the empty values.
# .env is git-ignored and never committed.

# ═══════════════════════════════════════════════════════════════════
# Storage
# ═══════════════════════════════════════════════════════════════════
# Local: absolute path on your machine
# Docker scheduler profile: Compose overrides this to the persistent /data volume
SCHOLIGHT_DATA_ROOT=./data

# ═══════════════════════════════════════════════════════════════════
# Zilliz Cloud (managed Milvus)
# ═══════════════════════════════════════════════════════════════════
SCHOLIGHT_ZILLIZ_URI=https://in05-d432d46d6c77308.serverless.ali-cn-hangzhou.cloud.zilliz.com.cn
SCHOLIGHT_ZILLIZ_TOKEN=

# ═══════════════════════════════════════════════════════════════════
# Embedding API (Qwen3-Embedding-0.6B, OpenAI-compatible)
# ═══════════════════════════════════════════════════════════════════
# Local: 硅基流动 → https://api.siliconflow.cn/v1
# Docker: faro-hosted → https://faro-embedding.openapi-qb-nat.sii.edu.cn/v1
SCHOLIGHT_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
SCHOLIGHT_EMBEDDING_API_KEY=
SCHOLIGHT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
SCHOLIGHT_EMBEDDING_DIM=1024
SCHOLIGHT_EMBEDDING_BATCH_SIZE=512
SCHOLIGHT_EMBEDDING_CONCURRENCY=8
SCHOLIGHT_INGEST_RECENT_DAYS=90
SCHOLIGHT_METADATA_SYNC_HOUR_UTC=8
SCHOLIGHT_INGEST_MAX_ATTEMPTS=8
SCHOLIGHT_INGEST_LEASE_SECONDS=7200

# ═══════════════════════════════════════════════════════════════════
# MinerU API (PDF parsing)
# ═══════════════════════════════════════════════════════════════════
SCHOLIGHT_MINERU_API_KEY=

# ═══════════════════════════════════════════════════════════════════
# PostgreSQL (AWS RDS — auth, search history)
# ═══════════════════════════════════════════════════════════════════
SCHOLIGHT_PG_HOST=sii-pg.cf0m0gegaz1c.ap-east-1.rds.amazonaws.com
SCHOLIGHT_PG_PORT=5432
SCHOLIGHT_PG_DATABASE=sanchezcloud
SCHOLIGHT_PG_USER=postgres
SCHOLIGHT_PG_PASSWORD=
# Local: relative path → global-bundle.pem
# Docker: absolute path → /etc/ssl/certs/global-bundle.pem
SCHOLIGHT_PG_SSL_ROOT_CERT=global-bundle.pem
SCHOLIGHT_PG_POOL_MIN_SIZE=5
SCHOLIGHT_PG_POOL_MAX_SIZE=20
SCHOLIGHT_PG_POOL_ACQUIRE_TIMEOUT=5.0
SCHOLIGHT_PG_POOL_COMMAND_TIMEOUT=10.0
SCHOLIGHT_PG_POOL_MAX_INACTIVE_LIFETIME=300.0

# ═══════════════════════════════════════════════════════════════════
# JWT & Auth
# ═══════════════════════════════════════════════════════════════════
# API startup requires a fixed random secret containing at least 32 UTF-8 bytes.
# Generate one with: openssl rand -base64 32
SCHOLIGHT_AUTH_JWT_SECRET=
SCHOLIGHT_AUTH_REFRESH_COOKIE_SECURE=false
SCHOLIGHT_PUBLIC_WEB_URL=http://127.0.0.1:5173
SCHOLIGHT_ACCESS_KEY_HMAC_SECRET=
# Must exactly match Scholens's SCHOLIGHT_MCP_DELEGATION_JWT_SECRET.
SCHOLIGHT_MCP_DELEGATION_JWT_SECRET=
SCHOLIGHT_JWT_ACCESS_TOKEN_TTL_MINUTES=15
SCHOLIGHT_JWT_REFRESH_TOKEN_TTL_DAYS=7
SCHOLIGHT_ACCOUNT_LOCKOUT_THRESHOLD=5
SCHOLIGHT_ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# ═══════════════════════════════════════════════════════════════════
# Survey (disabled by default)
# Provider credentials intentionally use their unprefixed names end to end.
# ═══════════════════════════════════════════════════════════════════
DEEPSEEK_API_KEY=
SCHOLIGHT_SURVEY_TITLE_API_URL=https://api.deepseek.com/chat/completions
IMAGE_GEN_API_KEY=
SCHOLIGHT_SURVEY_MCP_JWT_SECRET=
SCHOLIGHT_SURVEY_S3_BUCKET=
# Local development only: point this at MinIO. Leave empty in production to use AWS S3.
SCHOLIGHT_SURVEY_S3_ENDPOINT_URL=
SCHOLIGHT_SURVEY_ENABLED=false
SCHOLIGHT_SURVEY_DAILY_LIMIT=5
SCHOLIGHT_SURVEY_DRAFT_TIMEOUT_SECONDS=1800
SCHOLIGHT_SURVEY_JOB_TIMEOUT_SECONDS=86400
SCHOLIGHT_SURVEY_DRAFT_CONCURRENCY=8
SCHOLIGHT_SURVEY_JOB_CONCURRENCY=2
SCHOLIGHT_SURVEY_DRAFT_PER_USER_CONCURRENCY=2
SCHOLIGHT_SURVEY_JOB_PER_USER_CONCURRENCY=1
SCHOLIGHT_SURVEY_HEARTBEAT_SECONDS=15
SCHOLIGHT_SURVEY_LEASE_SECONDS=120

# Anonymous public search limits. The HMAC secret must be stable across API restarts
# and contain at least 32 UTF-8 bytes; generate it independently from the JWT secret.
SCHOLIGHT_ANONYMOUS_RATE_LIMIT_PER_MINUTE=30
SCHOLIGHT_ANONYMOUS_STANDARD_DAILY_LIMIT=100
SCHOLIGHT_ANONYMOUS_THOROUGH_DAILY_LIMIT=30
SCHOLIGHT_ANONYMOUS_QUOTA_HMAC_SECRET=

# ═══════════════════════════════════════════════════════════════════
# Email (Aliyun DirectMail — password reset, email verification)
# ═══════════════════════════════════════════════════════════════════
# If all fields are set, email features are enabled.
SCHOLIGHT_ALIYUN_DM_ACCESS_KEY_ID=
SCHOLIGHT_ALIYUN_DM_ACCESS_KEY_SECRET=
SCHOLIGHT_ALIYUN_DM_ACCOUNT_NAME=
SCHOLIGHT_ALIYUN_DM_FROM_ALIAS=Scholight
SCHOLIGHT_ALIYUN_DM_REPLY_TO_ADDRESS=true

# ═══════════════════════════════════════════════════════════════════
# Search — Level 1 paper recall
# ═══════════════════════════════════════════════════════════════════
# Fixed recall depth; final responses are still truncated to the requested limit.
SCHOLIGHT_SEARCH_PAPER_CANDIDATE_TOP_K=200


# ═══════════════════════════════════════════════════════════════════
# Search — Hybrid weights (paper-level, dense + BM25)
# ═══════════════════════════════════════════════════════════════════
SCHOLIGHT_SEARCH_HYBRID_DENSE_WEIGHT=0.60
SCHOLIGHT_SEARCH_HYBRID_BM25_WEIGHT=0.40


# ═══════════════════════════════════════════════════════════════════
# Search — Abstract-length quality penalty
# ═══════════════════════════════════════════════════════════════════
SCHOLIGHT_SEARCH_ABSTRACT_LEN_MIDPOINT=120
SCHOLIGHT_SEARCH_ABSTRACT_LEN_STEEPNESS=10.0

# ═══════════════════════════════════════════════════════════════════
# Search — RRF fusion & chunk aggregation
# ═══════════════════════════════════════════════════════════════════
SCHOLIGHT_SEARCH_RRF_K=60
SCHOLIGHT_SEARCH_RRF_PAPER_WEIGHT=0.5
SCHOLIGHT_SEARCH_RRF_CHUNK_WEIGHT=0.5
SCHOLIGHT_SEARCH_CHUNK_AGGREGATION_ALPHA=0.5
SCHOLIGHT_SEARCH_POSITION_WEIGHT_BETA=0.3
# Public abstract enrichment is best-effort and should degrade quickly.
SCHOLIGHT_SEARCH_ENRICHMENT_RPC_TIMEOUT_SECONDS=1.5
# Standard and Thorough execution remain bounded through every dependency layer.
SCHOLIGHT_SEARCH_LEVEL2_RPC_TIMEOUT_SECONDS=45.0
SCHOLIGHT_SEARCH_LEVEL2_TIMEOUT_SECONDS=60.0
SCHOLIGHT_BACKGROUND_QUEUE_MAX_SIZE=512
SCHOLIGHT_EMBEDDING_MAX_KEEPALIVE_CONNECTIONS=20

# ═══════════════════════════════════════════════════════════════════
# Search — AUTOINDEX recall level (3 ≈ 95% recall)
# ═══════════════════════════════════════════════════════════════════
SCHOLIGHT_SEARCH_LEVEL=3
SCHOLIGHT_CHUNK_SEARCH_LEVEL=3

# ═══════════════════════════════════════════════════════════════════
# CORS
# ═══════════════════════════════════════════════════════════════════
SCHOLIGHT_CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Server / Docker ingress
# Container internal port stays fixed at 8000. Host binding is separate.
SCHOLIGHT_SERVER_HOST=127.0.0.1
SCHOLIGHT_SERVER_PORT=8000
SCHOLIGHT_BIND_ADDRESS=127.0.0.1
SCHOLIGHT_HOST_PORT=8000
SCHOLIGHT_FRONTEND_PORT=3000
# Direct exposure: keep false. Behind a reverse proxy: true + exact proxy IP/subnet.
SCHOLIGHT_PROXY_HEADERS=false
SCHOLIGHT_FORWARDED_ALLOW_IPS=127.0.0.1,172.30.0.10
# Last-resort host guard; tune only with measured production load tests.
SCHOLIGHT_SERVER_LIMIT_CONCURRENCY=96
SCHOLIGHT_SERVER_KEEP_ALIVE_SECONDS=65
SCHOLIGHT_SERVER_BACKLOG=128
# Publish immutable image tags/digests in production, never `latest`.
SCHOLIGHT_IMAGE=scholight:0.1.0

# ═══════════════════════════════════════════════════════════════════
# Logging
# ═══════════════════════════════════════════════════════════════════
SCHOLIGHT_LOG_LEVEL=INFO
# 设为 true 输出 JSON 格式（生产环境自动启用）
SCHOLIGHT_LOG_JSON=
