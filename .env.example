# Academic Compass Environment Variables
# Copy this to .env and adjust for your deployment

# ═══════════════════════════════════════════════════════════════════════════════
# Storage
# ═══════════════════════════════════════════════════════════════════════════════
COMPASS_DATA_ROOT=/inspire/qb-ilm/project/multi-agent/niexiaohang-25130061/academic-data

# ═══════════════════════════════════════════════════════════════════════════════
# Zilliz Cloud
# ═══════════════════════════════════════════════════════════════════════════════
COMPASS_ZILLIZ_URI=https://in05-d432d46d6c77308.serverless.ali-cn-hangzhou.cloud.zilliz.com.cn
COMPASS_ZILLIZ_TOKEN=

# ═══════════════════════════════════════════════════════════════════════════════
# Embedding (硅基流动 Qwen3-Embedding-0.6B)
# ═══════════════════════════════════════════════════════════════════════════════
COMPASS_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
COMPASS_EMBEDDING_API_KEY=
COMPASS_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
COMPASS_EMBEDDING_DIM=1024
COMPASS_EMBEDDING_BATCH_SIZE=512
COMPASS_EMBEDDING_CONCURRENCY=8


# ═══════════════════════════════════════════════════════════════════════════════
# MinerU API
# ═══════════════════════════════════════════════════════════════════════════════
COMPASS_MINERU_API_KEY=

# ═══════════════════════════════════════════════════════════════════════════════
# PostgreSQL (AWS RDS) — shared with cloud-auth
# ═══════════════════════════════════════════════════════════════════════════════
# cloud-auth 不管理独立的 PG 连接池；PG pool 由 compass 创建并通过
# pool_factory 注入到 cloud-auth 的 AsyncpgUserDatabase。
COMPASS_PG_HOST=sii-pg.cf0m0gegaz1c.ap-east-1.rds.amazonaws.com
COMPASS_PG_PORT=5432
COMPASS_PG_DATABASE=postgres
COMPASS_PG_USER=postgres
COMPASS_PG_PASSWORD=
COMPASS_PG_SSL_ROOT_CERT=global-bundle.pem
COMPASS_PG_POOL_MIN_SIZE=5
COMPASS_PG_POOL_MAX_SIZE=20
COMPASS_PG_POOL_ACQUIRE_TIMEOUT=5.0
COMPASS_PG_POOL_COMMAND_TIMEOUT=10.0
COMPASS_PG_POOL_MAX_INACTIVE_LIFETIME=300.0

# ═══════════════════════════════════════════════════════════════════════════════
# JWT & Auth — 传递给 cloud-auth.AuthConfig
# ═══════════════════════════════════════════════════════════════════════════════
# secret 为空时自动生成（所有 token 在重启后失效）
COMPASS_AUTH_JWT_SECRET=
COMPASS_JWT_ACCESS_TOKEN_TTL_MINUTES=15
COMPASS_JWT_REFRESH_TOKEN_TTL_DAYS=7
COMPASS_ACCOUNT_LOCKOUT_THRESHOLD=5
COMPASS_ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# ═══════════════════════════════════════════════════════════════════════════════
# Aliyun DirectMail — 传递给 cloud-auth UserManager
# ═══════════════════════════════════════════════════════════════════════════════
COMPASS_ALIYUN_DM_ACCESS_KEY_ID=
COMPASS_ALIYUN_DM_ACCESS_KEY_SECRET=
COMPASS_ALIYUN_DM_ACCOUNT_NAME=
COMPASS_ALIYUN_DM_FROM_ALIAS=Academic Compass
COMPASS_ALIYUN_DM_REPLY_TO_ADDRESS=true

# ═══════════════════════════════════════════════════════════════════════════════
# Search — Hybrid weights (paper-level, dense + BM25)
# ═══════════════════════════════════════════════════════════════════════════════
COMPASS_SEARCH_HYBRID_DENSE_WEIGHT=0.60
COMPASS_SEARCH_HYBRID_BM25_WEIGHT=0.40

# ═══════════════════════════════════════════════════════════════════════════════
# Search — Rocchio query expansion
# ═══════════════════════════════════════════════════════════════════════════════
COMPASS_SEARCH_ROCCHIO_POS_K=3
COMPASS_SEARCH_ROCCHIO_MAX_TERMS=8
COMPASS_SEARCH_ROCCHIO_IDF_FLOOR=3.5
COMPASS_SEARCH_ROCCHIO_MAX_QUERY_LEN=512

# ═══════════════════════════════════════════════════════════════════════════════
# Search — Abstract-length quality penalty
# ═══════════════════════════════════════════════════════════════════════════════
COMPASS_SEARCH_ABSTRACT_LEN_MIDPOINT=120
COMPASS_SEARCH_ABSTRACT_LEN_STEEPNESS=10.0

# ═══════════════════════════════════════════════════════════════════════════════
# Search — RRF fusion & chunk aggregation
# ═══════════════════════════════════════════════════════════════════════════════
COMPASS_SEARCH_RRF_K=60
COMPASS_SEARCH_RRF_PAPER_WEIGHT=0.5
COMPASS_SEARCH_RRF_CHUNK_WEIGHT=0.5
COMPASS_SEARCH_CHUNK_AGGREGATION_ALPHA=0.5
COMPASS_SEARCH_POSITION_WEIGHT_BETA=0.3

# ═══════════════════════════════════════════════════════════════════════════════
# Search — AUTOINDEX recall level (3 ≈ 95% recall)
# ═══════════════════════════════════════════════════════════════════════════════
COMPASS_SEARCH_LEVEL=3
COMPASS_CHUNK_SEARCH_LEVEL=3


# ═══════════════════════════════════════════════════════════════════════════════
# CORS
# ═══════════════════════════════════════════════════════════════════════════════
COMPASS_CORS_ALLOW_ORIGINS=["*"]

# ═══════════════════════════════════════════════════════════════════════════════
# Server
# ═══════════════════════════════════════════════════════════════════════════════
COMPASS_SERVER_HOST=0.0.0.0
COMPASS_SERVER_PORT=8000

# ═══════════════════════════════════════════════════════════════════════════════
# Logging
# ═══════════════════════════════════════════════════════════════════════════════
COMPASS_LOG_LEVEL=INFO
# 设为 true 输出 JSON 格式（生产环境自动启用）
COMPASS_LOG_JSON=
