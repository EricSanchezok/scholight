name = "Scholight Survey Draft E2E"

model e2e-model {
    protocol = "openai"
    endpoint = "http://model:8080/v1"
    credentials = { env = "DEEPSEEK_API_KEY" }
    limit = { context = "1000000", output = "393216" }
    modalities = { input = ["text"], output = ["text"] }
}

mcp scholight {
    transport = http
    url = "http://api:8000/mcp"
    headers = { Authorization = env "SCHOLIGHT_SURVEY_MCP_AUTHORIZATION" }
}

accelerator {
    purpose = "Refine a Scholight Survey research requirement"
    models = ["e2e-model"]
    policy = "captain"
    prompts = { captain = file "../prompts/e2e_draft.txt" }
    mcps = ["scholight"]
}
