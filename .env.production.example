####################################################################
# Academic Compass — Production Environment Variables (template)
# ==============================================================
# Copy this file to .env.production and fill in the empty values.
# .env.production is git-ignored and never committed.
#
# The API container only needs the variables below — it never touches
# local disk (DATA_ROOT, SURVEY_RCM_ROOT, SURVEY_OUTPUT_ROOT are
# irrelevant).  Survey runs in production mode only (delegated to
# Gateway + RDC); local mode is unsupported in Docker.
####################################################################

# ═══════════════════════════════════════════════════════════════════
# REQUIRED — the container won't start correctly without these
# ═══════════════════════════════════════════════════════════════════

# JWT signing secret.  Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# If NOT set, a random secret is auto-generated on every restart,
# which invalidates ALL existing tokens.  Set this explicitly.
COMPASS_AUTH_JWT_SECRET=

# ── Zilliz Cloud (managed Milvus vector database) ──────────────────
COMPASS_ZILLIZ_URI=https://in05-d432d46d6c77308.serverless.ali-cn-hangzhou.cloud.zilliz.com.cn
COMPASS_ZILLIZ_TOKEN=

# ── PostgreSQL (AWS RDS — auth, projects, survey history) ──────────
COMPASS_PG_HOST=sii-pg.cf0m0gegaz1c.ap-east-1.rds.amazonaws.com
COMPASS_PG_PORT=5432
COMPASS_PG_DATABASE=postgres
COMPASS_PG_USER=postgres
COMPASS_PG_PASSWORD=
# The SSL cert is bundled inside the image at this absolute path.
# Only override if you need a different CA bundle.
COMPASS_PG_SSL_ROOT_CERT=/etc/ssl/certs/global-bundle.pem

# ── Embedding API (Qwen3-Embedding-0.6B, OpenAI-compatible) ────────
COMPASS_EMBEDDING_BASE_URL=https://faro-embedding.openapi-qb-nat.sii.edu.cn/v1
COMPASS_EMBEDDING_API_KEY=
COMPASS_EMBEDDING_MODEL=qwen3-embedding-0.6b
COMPASS_EMBEDDING_DIM=1024

# ═══════════════════════════════════════════════════════════════════
# Survey (production mode — delegates to Gateway + RDC)
# ═══════════════════════════════════════════════════════════════════

# Must be false in Docker.  Local mode spawns the RCM accelerate
# binary as a subprocess — not available in the container.
COMPASS_SURVEY_LOCAL_MODE=false

# Gateway — internal API for survey lifecycle orchestration
COMPASS_GATEWAY_INTERNAL_BASE=http://host.docker.internal:7100
# Public-facing URL the gateway advertises (for SSE redirects)
COMPASS_GATEWAY_PUBLIC_BASE=https://your-gateway.example.com
# Shared secret for internal service-to-service auth
COMPASS_SERVICE_TOKEN=

# RDC — research resource scheduler (GPU job enqueuing)
COMPASS_RDC_BASE=https://your-rdc.example.com
COMPASS_RDC_ADMIN_TOKEN=

# Aliyun OSS — survey output file storage
COMPASS_OSS_ACCESS_KEY_ID=
COMPASS_OSS_ACCESS_KEY_SECRET=
COMPASS_OSS_BUCKET=
COMPASS_OSS_REGION=

# ═══════════════════════════════════════════════════════════════════
# Optional
# ═══════════════════════════════════════════════════════════════════

# ── Email (Aliyun DirectMail — password reset, email verification) ─
# If all fields are set, email features are enabled.
# COMPASS_ALIYUN_DM_ACCESS_KEY_ID=
# COMPASS_ALIYUN_DM_ACCESS_KEY_SECRET=
# COMPASS_ALIYUN_DM_ACCOUNT_NAME=
# COMPASS_ALIYUN_DM_FROM_ALIAS=Academic Compass

# ── CORS — restrict in production to your frontend origin(s) ───────
# COMPASS_CORS_ALLOW_ORIGINS=["https://your-frontend.example.com"]

# ── Logging ────────────────────────────────────────────────────────
COMPASS_LOG_LEVEL=INFO
COMPASS_LOG_JSON=true

# ── Server (inside container, always bind 0.0.0.0:8000) ────────────
COMPASS_SERVER_HOST=0.0.0.0
COMPASS_SERVER_PORT=8000

# ── JWT TTL (override defaults only if needed) ─────────────────────
# COMPASS_JWT_ACCESS_TOKEN_TTL_MINUTES=15
# COMPASS_JWT_REFRESH_TOKEN_TTL_DAYS=7

# ── Auth lockout ───────────────────────────────────────────────────
# COMPASS_ACCOUNT_LOCKOUT_THRESHOLD=5
# COMPASS_ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# ── Project defaults ───────────────────────────────────────────────
# COMPASS_DEFAULT_GPU_HOURS=20.0
# COMPASS_PROJECT_TOTAL_LIMIT_DEFAULT=2
