####################################################################
# Scholight — Production Environment Variables (template)
# ==============================================================
# Copy this file to .env.production and fill in the empty values.
# .env.production is git-ignored and never committed.
#
# The API container only needs the variables below — it never touches
# local disk (DATA_ROOT, SURVEY_RCM_ROOT, SURVEY_OUTPUT_ROOT are
# irrelevant).  Survey runs in production mode only (delegated to
# Gateway + RDC); local mode is unsupported in Docker.
####################################################################

# ═══════════════════════════════════════════════════════════════════
# REQUIRED — the container won't start correctly without these
# ═══════════════════════════════════════════════════════════════════

# JWT signing secret.  Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# If NOT set, a random secret is auto-generated on every restart,
# which invalidates ALL existing tokens.  Set this explicitly.
SCHOLIGHT_AUTH_JWT_SECRET=

# ── Zilliz Cloud (managed Milvus vector database) ──────────────────
SCHOLIGHT_ZILLIZ_URI=https://in05-d432d46d6c77308.serverless.ali-cn-hangzhou.cloud.zilliz.com.cn
SCHOLIGHT_ZILLIZ_TOKEN=

# ── PostgreSQL (AWS RDS — auth, projects, survey history) ──────────
SCHOLIGHT_PG_HOST=sii-pg.cf0m0gegaz1c.ap-east-1.rds.amazonaws.com
SCHOLIGHT_PG_PORT=5432
SCHOLIGHT_PG_DATABASE=postgres
SCHOLIGHT_PG_USER=postgres
SCHOLIGHT_PG_PASSWORD=
# The SSL cert is bundled inside the image at this absolute path.
# Only override if you need a different CA bundle.
SCHOLIGHT_PG_SSL_ROOT_CERT=/etc/ssl/certs/global-bundle.pem

# ── Embedding API (Qwen3-Embedding-0.6B, OpenAI-compatible) ────────
SCHOLIGHT_EMBEDDING_BASE_URL=https://faro-embedding.openapi-qb-nat.sii.edu.cn/v1
SCHOLIGHT_EMBEDDING_API_KEY=
SCHOLIGHT_EMBEDDING_MODEL=qwen3-embedding-0.6b
SCHOLIGHT_EMBEDDING_DIM=1024

# ═══════════════════════════════════════════════════════════════════
# Survey (production mode — delegates to Gateway + RDC)
# ═══════════════════════════════════════════════════════════════════

# Must be false in Docker.  Local mode spawns the RCM accelerate
# binary as a subprocess — not available in the container.
SCHOLIGHT_SURVEY_LOCAL_MODE=false

# Gateway — internal API for survey lifecycle orchestration
SCHOLIGHT_GATEWAY_INTERNAL_BASE=http://host.docker.internal:7100
# Public-facing URL the gateway advertises (for SSE redirects)
SCHOLIGHT_GATEWAY_PUBLIC_BASE=https://your-gateway.example.com
# Shared secret for internal service-to-service auth
SCHOLIGHT_SERVICE_TOKEN=

# RDC — research resource scheduler (GPU job enqueuing)
SCHOLIGHT_RDC_BASE=https://your-rdc.example.com
SCHOLIGHT_RDC_ADMIN_TOKEN=

# Aliyun OSS — survey output file storage
SCHOLIGHT_OSS_ACCESS_KEY_ID=
SCHOLIGHT_OSS_ACCESS_KEY_SECRET=
SCHOLIGHT_OSS_BUCKET=
SCHOLIGHT_OSS_REGION=

# ═══════════════════════════════════════════════════════════════════
# Optional
# ═══════════════════════════════════════════════════════════════════

# ── Email (Aliyun DirectMail — password reset, email verification) ─
# If all fields are set, email features are enabled.
# SCHOLIGHT_ALIYUN_DM_ACCESS_KEY_ID=
# SCHOLIGHT_ALIYUN_DM_ACCESS_KEY_SECRET=
# SCHOLIGHT_ALIYUN_DM_ACCOUNT_NAME=
# SCHOLIGHT_ALIYUN_DM_FROM_ALIAS=Scholight

# ── CORS — restrict in production to your frontend origin(s) ───────
# SCHOLIGHT_CORS_ALLOW_ORIGINS=["https://your-frontend.example.com"]

# ── Logging ────────────────────────────────────────────────────────
SCHOLIGHT_LOG_LEVEL=INFO
SCHOLIGHT_LOG_JSON=true

# ── Server (inside container, always bind 0.0.0.0:8000) ────────────
SCHOLIGHT_SERVER_HOST=0.0.0.0
SCHOLIGHT_SERVER_PORT=8000

# ── JWT TTL (override defaults only if needed) ─────────────────────
# SCHOLIGHT_JWT_ACCESS_TOKEN_TTL_MINUTES=15
# SCHOLIGHT_JWT_REFRESH_TOKEN_TTL_DAYS=7

# ── Auth lockout ───────────────────────────────────────────────────
# SCHOLIGHT_ACCOUNT_LOCKOUT_THRESHOLD=5
# SCHOLIGHT_ACCOUNT_LOCKOUT_DURATION_MINUTES=15

# ── Project defaults ───────────────────────────────────────────────
# SCHOLIGHT_DEFAULT_GPU_HOURS=20.0
# SCHOLIGHT_PROJECT_TOTAL_LIMIT_DEFAULT=2
