name = "Scholight Survey Draft"

model deepseek-v4-flash {
    protocol = "openai"
    endpoint = "https://api.deepseek.com"
    credentials = { env = "DEEPSEEK_API_KEY" }
    timeout = "1800"
    limit = { context = "1000000", output = "393216" }
    modalities = { input = ["text"], output = ["text"] }
}

mcp scholight {
    transport = http
    url = "http://api:8000/mcp"
    headers = { Authorization = env "SCHOLIGHT_SURVEY_MCP_AUTHORIZATION" }
}

accelerator {
    purpose = "Refine a Scholight Survey research requirement"
    models = ["deepseek-v4-flash"]
    policy = "captain"
    prompts = { captain = file "../prompts/draft.txt" }
    mcps = ["scholight"]
}
