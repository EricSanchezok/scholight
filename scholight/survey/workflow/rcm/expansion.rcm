name = "Scholight Survey Expansion"

model deepseek-v4-flash {
    protocol = "openai"
    endpoint = "https://api.deepseek.com"
    credentials = { env = "DEEPSEEK_API_KEY" }
    limit = { context = "1000000", output = "393216" }
    modalities = { input = ["text"], output = ["text"] }
}

mcp scholight {
    transport = http
    url = "http://api:8000/mcp"
    headers = { Authorization = env "SCHOLIGHT_SURVEY_MCP_AUTHORIZATION" }
}

graph {
    accelerator citation_seed_selector {
        purpose = "Scholight survey citation seed selector"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/citation_seed_selector.txt" }
        tools = ["fs"]
    }

    accelerator reference_expander {
        purpose = "Scholight survey reference expander"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/reference_expander.txt" }
        tools = ["arxiv_download", "fs"]
        mcps = ["scholight"]
    }

    accelerator semantic_expander {
        purpose = "Scholight survey semantic expander"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/semantic_expander.txt" }
        tools = ["fs"]
        mcps = ["scholight"]
    }

    accelerator cross_domain_expander {
        purpose = "Scholight survey cross-domain expander"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/cross_domain_expander.txt" }
        tools = ["fs"]
        mcps = ["scholight"]
    }

    flux seed_handoff {
        channel = context
        mode = last
        arity = 1
    }

    flux expansion_merge {
        channel = context
        mode = last
        arity = 4
    }

    accelerator expansion_merger {
        purpose = "Scholight survey expansion merger"
        models = ["deepseek-v4-flash"]
        policy = "captain"
        prompts = { captain = file "../prompts/expansion_merger.txt" }
        tools = ["fs"]
    }

    input.context -> citation_seed_selector.context

    citation_seed_selector.context -> seed_handoff.slot(0)
    seed_handoff.out -> reference_expander.context
    citation_seed_selector.done -> reference_expander.trigger

    seed_handoff.out -> semantic_expander.context
    citation_seed_selector.done -> semantic_expander.trigger

    seed_handoff.out -> cross_domain_expander.context
    citation_seed_selector.done -> cross_domain_expander.trigger

    citation_seed_selector.context -> expansion_merge.slot(0)
    reference_expander.context -> expansion_merge.slot(1)
    semantic_expander.context -> expansion_merge.slot(2)
    cross_domain_expander.context -> expansion_merge.slot(3)

    expansion_merge.out -> expansion_merger.context

    expansion_merger.done -> output.done
    expansion_merger.context -> output.context
    expansion_merger.purpose -> output.purpose
}
