name = "Scholight Survey Anchor"

model deepseek-v4-flash {
    protocol = "deepseek"
    endpoint = "https://api.deepseek.com"
    credentials = { env = "DEEPSEEK_API_KEY" }
    timeout = "1800"
    thinking = "true"
    limit = { context = "1000000", output = "393216" }
    modalities = { input = ["text"], output = ["text"] }
}

accelerator {
    purpose = "automated literature survey agents with citation graph expansion"
    models = ["deepseek-v4-flash"]
    policy = "captain"
    prompts = { captain = file "../prompts/anchor.txt" }
    tools = ["fs"]
}
