name = "Scholight Survey Card Repair Plan"

model deepseek-v4-flash {
    protocol = "deepseek"
    endpoint = "https://api.deepseek.com"
    credentials = { env = "DEEPSEEK_API_KEY" }
    timeout = "1800"
    thinking = "true"
    limit = { context = "1000000", output = "393216" }
    modalities = { input = ["text"], output = ["text"] }
}

accelerator {
    purpose = "Repair missing Scholight survey cards"
    models = ["deepseek-v4-flash"]
    policy = "captain"
    prompts = { captain = file "../prompts/card_repair.txt" }
    tools = ["fs"]
}
