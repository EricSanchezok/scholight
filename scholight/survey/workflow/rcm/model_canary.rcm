name = "Scholight Survey Model Canary"

model deepseek-v4-flash {
    protocol = "openai"
    endpoint = "https://api.deepseek.com"
    credentials = { env = "DEEPSEEK_API_KEY" }
    timeout = "120"
    limit = { context = "4096", output = "64" }
    modalities = { input = ["text"], output = ["text"] }
}

accelerator {
    purpose = "fixed non-sensitive completion protocol canary"
    models = ["deepseek-v4-flash"]
    policy = "captain"
    prompts = { captain = file "../prompts/model_canary.txt" }
    tools = []
}
