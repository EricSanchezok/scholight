# ═══════════════════════════════════════════════════════════════════
# Academic Compass — .dockerignore
# ===================================================================
# The API Docker image only needs:
#   - compass/          (application source)
#   - pyproject.toml    (dependency manifest)
#   - uv.lock           (pinned dependency versions)
#   - global-bundle.pem  (AWS RDS SSL cert)
#   - cloud-auth/       (local clone, installed as path dep in Docker)
#   - docker/compass-api/ (startup script)
#
# Everything else is excluded to keep the build context small.
# ═══════════════════════════════════════════════════════════════════

# ── Python artifacts ──────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
build/
uv.lock.bak

# ── Git ───────────────────────────────────────────────────────────
.git/
.gitignore

# ── Secrets (top-level .env is for local dev — never in Docker) ──
.env

# ── Dev tooling ───────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pytest_cache/
.pre-commit-config.yaml
.pre-commit-hooks.yaml

# ── Data (sync daemon territory — the API never touches local disk) ──
data/
*.parquet
*.db
*.db-shm
*.db-wal

# ── Logs (generated by sync daemons on host) ──────────────────────
logs/

# ── Tests ─────────────────────────────────────────────────────────
tests/
**/tests/

# ── Sync & migration scripts (host-only, never imported by API) ───
scripts/

# ── Archive — old MinerU GPU Dockerfile, retired Milvus setup ─────
docker/archive/

# ── External repos (cloud-auth copied separately with Dockerfile) ──
RCM/
rdc/

# ── Research docs ─────────────────────────────────────────────────
docs/research/

# ── IDE ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Benchmark (local evaluation tooling) ──────────────────────────
/benchmark/

# ── OS ────────────────────────────────────────────────────────────
.DS_Store

# ── SII platform ──────────────────────────────────────────────────
.sii/

# ── Jupyter ───────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Core dumps ────────────────────────────────────────────────────
core.[0-9]*

# ── Misc ──────────────────────────────────────────────────────────
tmux-client-*.log
*.whl
.xxx/
nosql_*
module_table*
.NOSQL*
cache.*.db
