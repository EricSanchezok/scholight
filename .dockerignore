# ═══════════════════════════════════════════════════════════════════
# Scholight — Docker build context
# ===================================================================
# The shared API/scheduler image needs:
#   - scholight/             (application and scheduler source)
#   - migrations/           (Scholight PostgreSQL migrations)
#   - pyproject.toml         (dependency manifest)
#   - uv.lock                (pinned dependency versions)
#   - global-bundle.pem      (AWS RDS SSL cert)
#   - docker/scholight-api/  (API startup script and Dockerfile)
# cloud-auth is fetched at its pinned commit through a BuildKit secret.
#
# Everything else is excluded to keep the build context small.
# ═══════════════════════════════════════════════════════════════════

# ── Python artifacts ──────────────────────────────────────────────
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
build/
uv.lock.bak

# ── Git ───────────────────────────────────────────────────────────
.git/
.gitignore

# ── Secrets (top-level .env is for local dev — never in Docker) ──
.env

# ── Dev tooling ───────────────────────────────────────────────────
.mypy_cache/
.ruff_cache/
.pytest_cache/
.pre-commit-config.yaml
.pre-commit-hooks.yaml

# ── Local data (containers use the named /data volume) ────────────
data/
*.parquet
*.db
*.db-shm
*.db-wal

# ── Local logs (containers write runtime data under /data) ────────
logs/

# ── Tests ─────────────────────────────────────────────────────────
tests/
**/tests/

# ── Host-only operational scripts ─────────────────────────────────
scripts/

# ── Archive — old MinerU GPU Dockerfile, retired Milvus setup ─────
docker/archive/

# ── External repos (production cloud-auth is fetched at pinned SHA) ──
RCM/
rdc/
cloud-auth/

# ── Research docs ─────────────────────────────────────────────────
docs/research/

# ── IDE ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Benchmark (local evaluation tooling) ──────────────────────────
/benchmark/

# ── OS ────────────────────────────────────────────────────────────
.DS_Store

# ── SII platform ──────────────────────────────────────────────────
.sii/

# ── Jupyter ───────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Core dumps ────────────────────────────────────────────────────
core.[0-9]*

# ── Misc ──────────────────────────────────────────────────────────
tmux-client-*.log
*.whl
.xxx/
nosql_*
module_table*
.NOSQL*
cache.*.db
