# Secret-free immutable release manifest. Deploy uses image digests, never tags.
SCHOLIGHT_RELEASE_CONTRACT_VERSION=2
SCHOLIGHT_PACKAGE_SHA=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
SCHOLIGHT_RELEASE_SHA=0123456789abcdef0123456789abcdef01234567
SCHOLIGHT_BACKEND_IMAGE=123456789012.dkr.ecr.ap-east-1.amazonaws.com/scholight/backend@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
SCHOLIGHT_FRONTEND_IMAGE=123456789012.dkr.ecr.ap-east-1.amazonaws.com/scholight/frontend@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
SCHOLIGHT_EXTRACT_IMAGE=123456789012.dkr.ecr.ap-east-1.amazonaws.com/scholight/extract@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
