# Stable production runtime configuration. Copy to /etc/scholight/runtime.env,
# fill every required value, then chmod 0600. Never commit the real file.

# Ingress and release infrastructure
SCHOLIGHT_DOMAIN=
SCHOLIGHT_ACME_EMAIL=
SCHOLIGHT_AWS_REGION=
SCHOLIGHT_ECR_REGISTRY=
SCHOLIGHT_DOCKER_SUBNET=172.31.0.0/24
SCHOLIGHT_CADDY_IP=172.31.0.2
SCHOLIGHT_FRONTEND_IP=172.31.0.10
SCHOLIGHT_API_IP=172.31.0.20

# PostgreSQL / RDS. Use distinct least-privilege runtime and DDL owner roles.
SCHOLIGHT_PG_HOST=
SCHOLIGHT_PG_PORT=5432
SCHOLIGHT_PG_DATABASE=sanchezcloud
SCHOLIGHT_APP_PG_USER=scholight_app
SCHOLIGHT_APP_PG_PASSWORD=
SCHOLIGHT_MIGRATION_PG_USER=scholight_migrator
SCHOLIGHT_MIGRATION_PG_PASSWORD=
SCHOLIGHT_PG_POOL_MIN_SIZE=5
SCHOLIGHT_PG_POOL_MAX_SIZE=20

# Zilliz Cloud
SCHOLIGHT_ZILLIZ_URI=
SCHOLIGHT_ZILLIZ_TOKEN=

# Embedding API
SCHOLIGHT_EMBEDDING_BASE_URL=
SCHOLIGHT_EMBEDDING_API_KEY=
SCHOLIGHT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# Search recall depth and dependency budgets. Thorough covers cold Zilliz starts.
SCHOLIGHT_SEARCH_PAPER_CANDIDATE_TOP_K=200
SCHOLIGHT_SEARCH_ENRICHMENT_RPC_TIMEOUT_SECONDS=1.5
SCHOLIGHT_SEARCH_LEVEL2_RPC_TIMEOUT_SECONDS=45.0
SCHOLIGHT_SEARCH_LEVEL2_TIMEOUT_SECONDS=60.0
SCHOLIGHT_INGEST_RECENT_DAYS=90
SCHOLIGHT_METADATA_SYNC_HOUR_UTC=8
SCHOLIGHT_INGEST_MAX_ATTEMPTS=8
SCHOLIGHT_INGEST_LEASE_SECONDS=7200

# Stable application secrets. Generate independently and preserve across releases.
SCHOLIGHT_AUTH_JWT_SECRET=
SCHOLIGHT_ANONYMOUS_QUOTA_HMAC_SECRET=
SCHOLIGHT_ACCESS_KEY_HMAC_SECRET=

# Public same-origin deployment
SCHOLIGHT_PUBLIC_WEB_URL=https://replace-with-production-domain.example
SCHOLIGHT_CORS_ALLOW_ORIGINS=["https://replace-with-production-domain.example"]

# Public search limits
SCHOLIGHT_ANONYMOUS_RATE_LIMIT_PER_MINUTE=30
SCHOLIGHT_ANONYMOUS_STANDARD_DAILY_LIMIT=100
SCHOLIGHT_ANONYMOUS_THOROUGH_DAILY_LIMIT=30
SCHOLIGHT_AUTHENTICATED_STANDARD_DAILY_LIMIT=1000
SCHOLIGHT_AUTHENTICATED_THOROUGH_DAILY_LIMIT=1000

# Optional Aliyun DirectMail. Set all credential fields together or leave all empty.
SCHOLIGHT_ALIYUN_DM_ACCESS_KEY_ID=
SCHOLIGHT_ALIYUN_DM_ACCESS_KEY_SECRET=
SCHOLIGHT_ALIYUN_DM_ACCOUNT_NAME=
SCHOLIGHT_ALIYUN_DM_FROM_ALIAS=Scholight
SCHOLIGHT_ALIYUN_DM_REPLY_TO_ADDRESS=true

SCHOLIGHT_LOG_LEVEL=INFO
