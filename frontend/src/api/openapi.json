{
  "components": {
    "schemas": {
      "BulkDeleteSearchHistoryRequest": {
        "additionalProperties": false,
        "description": "Strict owner-scoped history IDs, stably deduplicated.",
        "properties": {
          "ids": {
            "items": {
              "maximum": 9.223372036854776e18,
              "minimum": 1.0,
              "type": "integer"
            },
            "maxItems": 100,
            "minItems": 1,
            "title": "Ids",
            "type": "array"
          }
        },
        "required": ["ids"],
        "title": "BulkDeleteSearchHistoryRequest",
        "type": "object"
      },
      "BulkDeleteSearchHistoryResponse": {
        "additionalProperties": false,
        "description": "Number of active owner-scoped rows soft-deleted by a bulk request.",
        "properties": {
          "deleted": {
            "minimum": 0.0,
            "title": "Deleted",
            "type": "integer"
          }
        },
        "required": ["deleted"],
        "title": "BulkDeleteSearchHistoryResponse",
        "type": "object"
      },
      "ChangePasswordRequest": {
        "properties": {
          "current_password": {
            "title": "Current Password",
            "type": "string"
          },
          "new_password": {
            "minLength": 12,
            "title": "New Password",
            "type": "string"
          }
        },
        "required": ["current_password", "new_password"],
        "title": "ChangePasswordRequest",
        "type": "object"
      },
      "ForgotPasswordRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          }
        },
        "required": ["email"],
        "title": "ForgotPasswordRequest",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "title": "Password",
            "type": "string"
          }
        },
        "required": ["email", "password"],
        "title": "LoginRequest",
        "type": "object"
      },
      "MessageResponse": {
        "properties": {
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": ["message"],
        "title": "MessageResponse",
        "type": "object"
      },
      "PublicSearchFilters": {
        "additionalProperties": false,
        "description": "Filters supported by the public HTTP search contract.",
        "properties": {
          "authors": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "title": "Authors",
            "type": "array"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "maxItems": 10,
            "title": "Categories",
            "type": "array"
          },
          "date_from": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date From"
          },
          "date_to": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Date To"
          }
        },
        "title": "PublicSearchFilters",
        "type": "object"
      },
      "PublicSearchHistoryItem": {
        "additionalProperties": false,
        "description": "One public history item without internal strategy or level fields.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "elapsed_ms": {
            "minimum": 0.0,
            "title": "Elapsed Ms",
            "type": "number"
          },
          "filters": {
            "$ref": "#/components/schemas/PublicSearchFilters"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "result_count": {
            "minimum": 0.0,
            "title": "Result Count",
            "type": "integer"
          },
          "strength": {
            "$ref": "#/components/schemas/SearchStrength"
          }
        },
        "required": [
          "id",
          "query",
          "strength",
          "filters",
          "result_count",
          "elapsed_ms",
          "created_at"
        ],
        "title": "PublicSearchHistoryItem",
        "type": "object"
      },
      "PublicSearchHistoryPage": {
        "additionalProperties": false,
        "description": "A paginated search-history response with an exact snapshot total.",
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PublicSearchHistoryItem"
            },
            "title": "Items",
            "type": "array"
          },
          "limit": {
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "offset": {
            "minimum": 0.0,
            "title": "Offset",
            "type": "integer"
          },
          "total": {
            "minimum": 0.0,
            "title": "Total",
            "type": "integer"
          }
        },
        "required": ["items", "total", "limit", "offset"],
        "title": "PublicSearchHistoryPage",
        "type": "object"
      },
      "PublicSearchHit": {
        "additionalProperties": false,
        "description": "A ranked paper result without internal search diagnostics.",
        "properties": {
          "abstract": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Abstract"
          },
          "arxiv_id": {
            "minLength": 1,
            "title": "Arxiv Id",
            "type": "string"
          },
          "arxiv_url": {
            "format": "uri",
            "minLength": 1,
            "title": "Arxiv Url",
            "type": "string"
          },
          "authors": {
            "items": {
              "type": "string"
            },
            "title": "Authors",
            "type": "array"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "title": "Categories",
            "type": "array"
          },
          "pdf_url": {
            "format": "uri",
            "minLength": 1,
            "title": "Pdf Url",
            "type": "string"
          },
          "rank": {
            "description": "Authoritative order within this response.",
            "minimum": 1.0,
            "title": "Rank",
            "type": "integer"
          },
          "score": {
            "description": "Unnormalized retrieval signal; compare only within the current response, never across queries, strengths, indexes, models, or time.",
            "title": "Score",
            "type": "number"
          },
          "submitted_at": {
            "format": "date-time",
            "title": "Submitted At",
            "type": "string"
          },
          "title": {
            "minLength": 1,
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "version": {
            "minimum": 1.0,
            "title": "Version",
            "type": "integer"
          }
        },
        "required": [
          "rank",
          "score",
          "arxiv_id",
          "title",
          "authors",
          "abstract",
          "categories",
          "submitted_at",
          "updated_at",
          "version",
          "arxiv_url",
          "pdf_url"
        ],
        "title": "PublicSearchHit",
        "type": "object"
      },
      "PublicSearchRequest": {
        "additionalProperties": false,
        "description": "Stable public search input, isolated from internal pipeline controls.",
        "examples": [
          {
            "filters": {
              "authors": [],
              "categories": ["cs.AI", "cs.IR"],
              "date_from": "2020-01-01"
            },
            "limit": 10,
            "query": "retrieval augmented generation",
            "strength": "standard"
          }
        ],
        "properties": {
          "filters": {
            "$ref": "#/components/schemas/PublicSearchFilters"
          },
          "limit": {
            "default": 10,
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Limit",
            "type": "integer"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "strength": {
            "$ref": "#/components/schemas/SearchStrength",
            "default": "standard"
          }
        },
        "required": ["query"],
        "title": "PublicSearchRequest",
        "type": "object"
      },
      "PublicSearchResponse": {
        "additionalProperties": false,
        "description": "Public search response; rank is authoritative and score is unnormalized.",
        "examples": [
          {
            "degraded": true,
            "elapsed_ms": 842.37,
            "hits": [
              {
                "arxiv_id": "2401.12345",
                "arxiv_url": "https://arxiv.org/abs/2401.12345",
                "authors": ["Example Author"],
                "categories": ["cs.AI", "cs.IR"],
                "pdf_url": "https://arxiv.org/pdf/2401.12345",
                "rank": 1,
                "score": 12.75,
                "submitted_at": "2024-01-20T00:00:00Z",
                "title": "A Paper About Retrieval",
                "updated_at": "2024-03-05T00:00:00Z",
                "version": 2
              }
            ],
            "query": "retrieval augmented generation",
            "result_count": 1,
            "strength": "standard"
          }
        ],
        "properties": {
          "degraded": {
            "title": "Degraded",
            "type": "boolean"
          },
          "elapsed_ms": {
            "minimum": 0.0,
            "title": "Elapsed Ms",
            "type": "number"
          },
          "hits": {
            "items": {
              "$ref": "#/components/schemas/PublicSearchHit"
            },
            "title": "Hits",
            "type": "array"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "result_count": {
            "minimum": 0.0,
            "title": "Result Count",
            "type": "integer"
          },
          "strength": {
            "$ref": "#/components/schemas/SearchStrength"
          }
        },
        "required": ["query", "strength", "degraded", "hits", "result_count", "elapsed_ms"],
        "title": "PublicSearchResponse",
        "type": "object"
      },
